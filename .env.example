# Optional. Only read when you pass `--planner llm`; every other code path is
# fully offline and needs nothing here.
ANTHROPIC_API_KEY=

# Model used by the optional LLM planner.
CLAUDE_MODEL=claude-opus-5

# Logging. level: debug|info|warning|error   format: text|json
CODESENTRY_LOG_LEVEL=warning
CODESENTRY_LOG_FORMAT=text

# Where the incremental analysis cache lives (default: .codesentry-cache/cache.db
# under the reviewed root).
CODESENTRY_CACHE=
